#!/bin/bash
#PBS -N bumbalm_avaliar
#PBS -q accel
#PBS -l nodes=1:ppn=15
# Tempo maximo do job. Descomente e ajuste quando souber o limite da fila accel:
##PBS -l walltime=72:00:00
# Saida e erro juntos. Caminho relativo a pasta de onde voce rodou o qsub (raiz do projeto).
#PBS -j oe
#PBS -o logs/bumbalm_avaliar.pbs.log

cd "$PBS_O_WORKDIR"
source cluster/env.sh
set -eo pipefail

LOG="logs/bumbalm_avaliar_${PBS_JOBID%%.*}.log"
echo "Job $PBS_JOBID em $(hostname) | $(date)" | tee "$LOG"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | tee -a "$LOG"
python -c "import torch; print('PyTorch', torch.__version__, '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NENHUMA')" | tee -a "$LOG"

# Etapa 5: modelo base + todas as variantes treinadas, no split de teste completo.
#   qsub cluster/pbs/04_avaliar.pbs
python -u scripts/05_evaluate.py --compare_baseline --split test 2>&1 | tee -a "$LOG"
