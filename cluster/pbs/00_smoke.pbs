#!/bin/bash
#PBS -N bumbalm_smoke
#PBS -q accel
#PBS -l nodes=1:ppn=15
# Tempo maximo do job. Descomente e ajuste quando souber o limite da fila accel:
##PBS -l walltime=72:00:00
# Saida e erro juntos. Caminho relativo a pasta de onde voce rodou o qsub (raiz do projeto).
#PBS -j oe
#PBS -o logs/bumbalm_smoke.pbs.log

cd "$PBS_O_WORKDIR"
source cluster/env.sh
set -eo pipefail

LOG="logs/bumbalm_smoke_${PBS_JOBID%%.*}.log"
echo "Job $PBS_JOBID em $(hostname) | $(date)" | tee "$LOG"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | tee -a "$LOG"
python -c "import torch; print('PyTorch', torch.__version__, '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NENHUMA')" | tee -a "$LOG"

# Teste rapido de ponta a ponta: 500 processos, 640 tuplas por variante, pastas separadas
# (data/smoke_tjma e experiments/smoke_tjma). Confere ambiente, memoria e mede segundos por passo.
#   qsub cluster/pbs/00_smoke.pbs
python -u scripts/run_pipeline.py --all \
    --config_base configs/config_base_smoke.yaml \
    --max_por_tribunal 500 \
    --negativos nenhum,aleatorios,dificeis \
    --limite_tuplas 640 \
    --compare_baseline 2>&1 | tee -a "$LOG"
