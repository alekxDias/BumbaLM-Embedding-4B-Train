#!/bin/bash
#PBS -N bumba_tjma500
#PBS -o cluster/tapajos/logs/tjma_500.out
#PBS -e cluster/tapajos/logs/tjma_500.err
#PBS -q accel
#PBS -l nodes=1:ppn=15
#PBS -l walltime=04:00:00

# Teste TJMA com ~500 processos na A100 (fila accel)
# Rode o qsub de dentro de: /projetos/ctcca/nlp/bumbalm

cd "$PBS_O_WORKDIR" || exit 1

module load cuda

# Ambiente conda do Tapajos (isolado em /projetos)
CONDA_ENV=/projetos/ctcca/nlp/bumbalm/env
PYTHON_BIN="${CONDA_ENV}/bin/python"

# Prioriza bibliotecas do ambiente isolado
export LD_LIBRARY_PATH="${CONDA_ENV}/lib/:${LD_LIBRARY_PATH}"
export HF_HOME="${PBS_O_WORKDIR}/hf_cache"
export TRANSFORMERS_CACHE="${HF_HOME}"
export HUGGINGFACE_HUB_CACHE="${HF_HOME}"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export CUDA_LAUNCH_BLOCKING=1

mkdir -p cluster/tapajos/logs hf_cache data/raw data/processed_tjma experiments

echo "=========================================="
echo "Host: $(hostname)"
echo "Data: $(date)"
echo "Dir : ${PBS_O_WORKDIR}"
echo "Py  : ${PYTHON_BIN}"
echo "PBS GPU: ${CUDA_VISIBLE_DEVICES}"
which nvidia-smi && nvidia-smi
"${PYTHON_BIN}" -c "import torch; print('PyTorch:', torch.__version__, '| CUDA:', torch.version.cuda, '| Dispositivo:', torch.cuda.get_device_name(0), '| Capability:', torch.cuda.get_device_capability(0), '| BF16:', torch.cuda.is_bf16_supported())"
echo "=========================================="

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "ERRO: python nao encontrado em ${PYTHON_BIN}"
  exit 1
fi

if [[ ! -f data/raw/pares_tjma.jsonl ]]; then
  echo "ERRO: falta data/raw/pares_tjma.jsonl"
  exit 1
fi

"${PYTHON_BIN}" scripts/run_pipeline.py \
  --smoke_test \
  --compare_baseline \
  --gpus 0 \
  --output_dir experiments/exp_tjma_500

echo "Fim: $(date)"

